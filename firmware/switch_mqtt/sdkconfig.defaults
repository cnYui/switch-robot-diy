# Switch Robot Carrier V0.5: ESP32-C3-MINI-1-N4 (4 MB flash), USB-C on the chip's own USB-Serial-JTAG
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Logs and the settings console on the USB-C port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Updates over Wi-Fi from the hub on the LAN (plain HTTP inside the home network)
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
