diff --git a/hw/misc/esp32_ledc.c b/hw/misc/esp32_ledc.c
index 9cebea9..2fb62e9 100644
--- a/hw/misc/esp32_ledc.c
+++ b/hw/misc/esp32_ledc.c
@@ -51,10 +51,74 @@ static uint32_t esp32_ledc_get_percent(Esp32LEDCState *s, uint32_t value, hwaddr
     return duty_res ? (100 * duty_val / ((2 << (duty_res - 1)) - 1)) : 0;
 }
 
+static void esp32_ledc_cosim_write(Esp32LEDCState *s, hwaddr addr, uint32_t value)
+{
+    if (addr >= sizeof(s->regs)) {
+        return;
+    }
+    s->regs[addr / 4] = value;
+    if (addr < 0x140) {
+        int ch = addr / 0x14;
+        int off = addr % 0x14;
+        bool high_speed = ch < 8;
+        uint32_t duty_reg = s->regs[(ch * 0x14 + 0x08) / 4];
+        if (off == 0x0C && (value & (1u << 31))) {
+            /* CONF1.DUTY_START: high-speed channels latch immediately; low-speed
+             * channels also need PARA_UP, which the IDF driver sets afterwards. */
+            if (high_speed) {
+                s->latched_duty[ch] = duty_reg;
+            }
+        } else if (off == 0x00 && !high_speed && (value & (1u << 4))) {
+            s->latched_duty[ch] = duty_reg;
+        }
+    }
+}
+
+bool esp32_ledc_channel_output(Esp32LEDCState *s, int ch, double apb_hz,
+                               double *freq_hz, double *duty)
+{
+    bool high_speed = ch < 8;
+    uint32_t conf0 = s->regs[(ch * 0x14) / 4];
+    int timer = conf0 & 3;
+    uint32_t tconf = s->regs[((high_speed ? 0x140 : 0x160) + timer * 8) / 4];
+    uint32_t res = tconf & 0x1f;
+    uint32_t div = (tconf >> 5) & 0x3ffff;
+    bool paused = tconf & (1u << 23);
+    bool rst = tconf & (1u << 24);
+    bool tick_sel = tconf & (1u << 25);
+    bool sig_out_en = conf0 & (1u << 2);
+    double clk;
+    if (!sig_out_en || rst || paused || res == 0 || div < 256) {
+        *freq_hz = 0;
+        *duty = (conf0 & (1u << 3)) ? 1.0 : 0.0;
+        return false;
+    }
+    if (high_speed) {
+        clk = tick_sel ? apb_hz : 1e6;           /* APB_CLK or REF_TICK */
+    } else {
+        bool apb_sel = s->regs[0x190 / 4] & 1;  /* LEDC_CONF.APB_CLK_SEL */
+        clk = tick_sel ? (apb_sel ? apb_hz : 8e6) : 1e6;
+    }
+    *freq_hz = clk / (div / 256.0) / (double)(1u << res);
+    *duty = (s->latched_duty[ch] / 16.0) / (double)(1u << res);
+    if (*duty > 1.0) {
+        *duty = 1.0;
+    }
+    return true;
+}
+
+static void esp32_ledc_reset(DeviceState *dev)
+{
+    Esp32LEDCState *s = ESP32_LEDC(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->latched_duty, 0, sizeof(s->latched_duty));
+}
+
 static void esp32_ledc_write(void *opaque, hwaddr addr,
                             uint64_t value, unsigned int size)
 {
     Esp32LEDCState *s = ESP32_LEDC(opaque);
+    esp32_ledc_cosim_write(s, addr, (uint32_t)value);
     switch (addr) {
     case A_LEDC_HSTIMER0_CONF_REG ... A_LEDC_LSTIMER3_CONF_REG:
         /* get duty resolution from timer config */
@@ -136,6 +200,7 @@ static void esp32_ledc_class_init(ObjectClass *klass, void *data)
 {
     DeviceClass *dc = DEVICE_CLASS(klass);
     dc->realize = esp32_ledc_realize;
+    dc->reset = esp32_ledc_reset;
 }
 
