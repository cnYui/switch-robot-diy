+    case 0x30: s->enable |= (v & 0xff) << 32; break;
+    case 0x34: s->enable &= ~((v & 0xff) << 32); break;
+    case 0x530 ... 0x530 + 4 * 39:
+        s->func_out_sel[(addr - 0x530) / 4] = (uint32_t)value;
+        break;
+    default:
+        break;
+    }
 }
 
