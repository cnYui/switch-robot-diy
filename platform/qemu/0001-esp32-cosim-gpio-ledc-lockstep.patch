diff --git a/hw/xtensa/esp32_cosim.c b/hw/xtensa/esp32_cosim.c
new file mode 100644
index 0000000..9c46b45
--- /dev/null
+++ b/hw/xtensa/esp32_cosim.c
@@ -0,0 +1,218 @@
+/*
+ * ESP32 lock-step co-simulation link.
+ *
+ * Every ESP32_COSIM_PERIOD_US microseconds of *virtual* time (default 1000)
+ * the emulator stops, sends one text line describing the pin outputs to an
+ * external simulator over a socket, and blocks until it receives one line
+ * with the pin inputs and the supply state.  Run QEMU with -icount so that
+ * virtual time is decoupled from wall-clock time; the external simulator then
+ * owns the shared clock.
+ *
+ *   QEMU -> sim:  F <seq> <vtime_ns> <out_hex> <en_hex> <nreset> <npwm>
+ *                   [<gpio>:<freq_hz>:<duty>]...\n
+ *   sim -> QEMU:  I <in_hex> <power_good>\n      (power_good 0 = brown-out)
+ *                 Q\n                            (quit the emulator)
+ *
+ * While power_good is 0 the SoC is held in reset with the reset cause set to
+ * RTCWDT_BROWN_OUT_RESET, which is what esp_reset_reason() reports after a
+ * real brown-out.
+ *
+ * Copyright (c) 2026 the emcosim authors.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/timer.h"
+#include "qemu/main-loop.h"
+#include "sysemu/runstate.h"
+#include "qemu/sockets.h"
+#include "qapi/error.h"
+#include "hw/xtensa/esp32.h"
+
+#define LEDC_HS_SIG_OUT0_IDX 71
+#define LEDC_LS_SIG_OUT0_IDX 79
+
+typedef struct {
+    Esp32SocState *soc;
+    QEMUTimer *timer;
+    int fd;
+    int64_t period_ns;
+    int64_t next_ns;
+    uint64_t seq;
+    uint32_t resets;
+    bool power_good;
+    char rx[256];
+    size_t rx_len;
+} Esp32Cosim;
+
+static Esp32Cosim cosim;
+
+static void cosim_fail(const char *what)
+{
+    error_report("esp32 cosim: %s; shutting down", what);
+    qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_ERROR);
+    if (cosim.fd >= 0) {
+#ifdef _WIN32
+        closesocket(cosim.fd);
+#else
+        close(cosim.fd);
+#endif
+        cosim.fd = -1;
+    }
+}
+
+static bool cosim_send(const char *buf, size_t len)
+{
+    while (len) {
+        ssize_t n = send(cosim.fd, buf, len, 0);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n <= 0) {
+            return false;
+        }
+        buf += n;
+        len -= n;
+    }
+    return true;
+}
+
+static bool cosim_recv_line(char *line, size_t cap)
+{
+    for (;;) {
+        char *nl = memchr(cosim.rx, '\n', cosim.rx_len);
+        if (nl) {
+            size_t n = nl - cosim.rx;
+            if (n >= cap) {
+                return false;
+            }
+            memcpy(line, cosim.rx, n);
+            line[n] = 0;
+            memmove(cosim.rx, nl + 1, cosim.rx_len - n - 1);
+            cosim.rx_len -= n + 1;
+            return true;
+        }
+        if (cosim.rx_len == sizeof(cosim.rx)) {
+            return false;
+        }
+        ssize_t r = recv(cosim.fd, cosim.rx + cosim.rx_len,
+                         sizeof(cosim.rx) - cosim.rx_len, 0);
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        if (r <= 0) {
+            return false;
+        }
+        cosim.rx_len += r;
+    }
+}
+
+static void cosim_tick(void *opaque)
+{
+    Esp32SocState *s = cosim.soc;
+    Esp32GpioState *g = &s->gpio;
+    GString *out = g_string_new(NULL);
+    GString *pwm = g_string_new(NULL);
+    int npwm = 0;
+    char line[256];
+
+    if (cosim.fd < 0) {
+        g_string_free(out, true);
+        g_string_free(pwm, true);
+        return;
+    }
+
+    for (int pin = 0; pin < 40; pin++) {
+        uint32_t sig = g->func_out_sel[pin] & 0x1ff;
+        int ch = -1;
+        if (sig >= LEDC_HS_SIG_OUT0_IDX && sig < LEDC_HS_SIG_OUT0_IDX + 8) {
+            ch = sig - LEDC_HS_SIG_OUT0_IDX;
+        } else if (sig >= LEDC_LS_SIG_OUT0_IDX && sig < LEDC_LS_SIG_OUT0_IDX + 8) {
+            ch = 8 + sig - LEDC_LS_SIG_OUT0_IDX;
+        }
+        if (ch >= 0 && (g->enable >> pin & 1)) {
+            double freq, duty;
+            esp32_ledc_channel_output(&s->ledc, ch, 80e6, &freq, &duty);
+            if (g->func_out_sel[pin] & (1u << 9)) {   /* INV_SEL */
+                duty = 1.0 - duty;
+            }
+            g_string_append_printf(pwm, " %d:%.6f:%.8f", pin, freq, duty);
+            npwm++;
+        }
+    }
+    g_string_printf(out, "F %" PRIu64 " %" PRId64 " %" PRIx64 " %" PRIx64 " %u %d%s\n",
+                    cosim.seq++, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                    g->out, g->enable, cosim.resets, npwm, pwm->str);
+    bool ok = cosim_send(out->str, out->len);
+    g_string_free(out, true);
+    g_string_free(pwm, true);
+    if (!ok || !cosim_recv_line(line, sizeof(line))) {
+        cosim_fail("link closed");
+        return;
+    }
+    if (line[0] == 'Q') {
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_QMP_QUIT);
+        return;
+    }
+    uint64_t in = 0;
+    int power = 1;
+    if (sscanf(line, "I %" SCNx64 " %d", &in, &power) < 1) {
+        cosim_fail("malformed input line");
+        return;
+    }
+    g->in = in;
+    if (!power) {
+        /* Brown-out: hold the chip in reset for as long as the supply is low. */
+        for (int i = 0; i < ESP32_CPU_COUNT; i++) {
+            s->rtc_cntl.reset_cause[i] = ESP32_RTCWDT_BROWN_OUT_RESET;
+        }
+        s->requested_reset = 0x7; /* PROCPU | APPCPU | PERIPH */
+        if (cosim.power_good) {
+            cosim.resets++;
+        }
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    }
+    cosim.power_good = power;
+
+    cosim.next_ns += cosim.period_ns;
+    timer_mod(cosim.timer, cosim.next_ns);
+}
+
+void esp32_cosim_init(Esp32SocState *s)
+{
+    /* ESP32_COSIM_SOCKET is either "tcp:HOST:PORT" (works on every host,
+     * used on Windows) or a UNIX socket path. */
+    const char *path = getenv("ESP32_COSIM_SOCKET");
+    const char *period = getenv("ESP32_COSIM_PERIOD_US");
+    Error *err = NULL;
+
+    cosim.fd = -1;
+    if (!path || !*path) {
+        return;
+    }
+    if (g_str_has_prefix(path, "tcp:")) {
+        cosim.fd = inet_connect(path + 4, &err);
+    } else {
+        cosim.fd = unix_connect(path, &err);
+    }
+    if (cosim.fd < 0) {
+        error_reportf_err(err, "esp32 cosim: cannot connect to %s: ", path);
+        exit(1);
+    }
+    socket_set_nodelay(cosim.fd);
+    qemu_socket_set_block(cosim.fd);
+    cosim.soc = s;
+    cosim.power_good = true;
+    cosim.period_ns = (period ? atoll(period) : 1000) * 1000LL;
+    if (cosim.period_ns <= 0) {
+        cosim.period_ns = 1000000;
+    }
+    cosim.next_ns = cosim.period_ns;
+    cosim.timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, cosim_tick, NULL);
+    timer_mod(cosim.timer, cosim.next_ns);
+    info_report("esp32 cosim: linked to %s, step %" PRId64 " ns", path, cosim.period_ns);
+}
