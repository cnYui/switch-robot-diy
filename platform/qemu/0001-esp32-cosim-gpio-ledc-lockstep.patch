                        uint64_t value, unsigned int size)
 {
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    const uint64_t lo = 0xffffffffULL, hi = 0xffULL << 32;
+    uint64_t v = (uint32_t)value;
+    switch (addr) {
