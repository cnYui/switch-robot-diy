+    case 0x08: s->out |= v; break;
+    case 0x0C: s->out &= ~v; break;
+    case 0x10: s->out = (s->out & lo) | ((v & 0xff) << 32); break;
+    case 0x14: s->out |= (v & 0xff) << 32; break;
+    case 0x18: s->out &= ~((v & 0xff) << 32); break;
+    case 0x20: s->enable = (s->enable & hi) | v; break;
+    case 0x24: s->enable |= v; break;
+    case 0x28: s->enable &= ~v; break;
